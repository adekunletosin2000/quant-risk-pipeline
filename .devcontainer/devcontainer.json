{
  "name": "Multi-Asset Risk Dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postStartCommand": "bash .devcontainer/start-dashboard.sh",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Risk dashboard",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
